# LLM fallback chain: xkiro(최우선) → agnes → groq → gemini (키 있는 것만 사용)
# export XKIRO_API_KEY=...       # https://api.xkiro.com/v1, model qwen/qwen3.8-max:free
# export XKIRO_MODEL="qwen/qwen3.8-max:free"
# export AGNES_API_KEY=...        # https://llm.orla.cc/v1, model agnes-3.0-flash
# export AGNES_MODEL="agnes-3.0-flash"
# export GROQ_API_KEY=...
# export GROQ_MODEL="openai/gpt-oss-120b"
# export GEMINI_API_KEY=...
# export GEMINI_MODEL="gemini-3.1-flash-lite"
# export LLM_CHAIN="xkiro,agnes,groq,gemini"   # 순서/부분집합 override
# 하위호환: LLM_PROVIDER/LLM_MODEL/LLM_API_KEY/LLM_API_BASE (단일 지정 시 체인 무시)
export WEB_SEARCH_PROVIDER=jina
# JINA_API_KEY 는 hybrid 검색의 vector 절반 + web_search 양쪽에 쓴다.
# 크레딧이 소진되면(403) search_reports 가 BM25 단독으로 강등하고
# scoring.degraded 에 근거를 남긴다 — 조용히 품질이 떨어지지 않는다.
# export JINA_API_KEY=...
# export TAVILY_API_KEY=...     # if WEB_SEARCH_PROVIDER=tavily
# export MAX_LLM_CYCLES=6

# 조달데이터허브 MCP 서버. 기본값은 이 앱이 직접 서빙하는 /mcp
# (http://127.0.0.1:$PORT/mcp/) — 따로 설정할 필요 없음.
# 원격 MCP 를 함께 쓰려면 아래처럼 덮어쓴다(리스트이므로 복수 지정 가능):
# export MCP_SERVERS='[{"name":"jodal","url":"http://127.0.0.1:8078/mcp/","transport":"STREAMABLE_HTTP"},{"name":"other","url":"http://127.0.0.1:8099/mcp/","transport":"STREAMABLE_HTTP"}]'

# 검색 가중. vector_weight 기본 0.7. 0 이면 BM25 단독.
# export VECTOR_WEIGHT=0.7

# open_url fetch limits (stdlib HTML parser, no extra deps)
# export OPEN_URL_TIMEOUT_SECONDS=30
# export OPEN_URL_MAX_URLS=5
# export OPEN_URL_MAX_CHARS_PER_PAGE=15000
# export OPEN_URL_MAX_CHARS_TOTAL=150000
